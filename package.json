{
  "name": "petcare-fullstack",
  "version": "1.0.0",
  "scripts": {
    "start": "npm run backend",
    "start:fullstack": "concurrently \"npm run backend\" \"npm run frontend\"",
    "dev": "concurrently \"npm run backend-dev\" \"npm run frontend\"",
    "backend": "cd app/backend && npm start",
    "backend-dev": "cd app/backend && npm run dev",
    "frontend": "cd app/frontend && npm run dev",
    "build": "cd app/backend && npm install",
    "install-all": "concurrently \"cd app/backend && npm install\" \"cd app/frontend && npm install\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
